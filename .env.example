# Base de données (SQLite en local, remplaçable par PostgreSQL en production)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="changez-moi-en-production-avec-une-valeur-aleatoire-longue"
NEXTAUTH_URL="http://localhost:3000"

# Assistant IA (Anthropic) — optionnel, l'assistant affiche un message si absent
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Envoi d'emails (optionnel — sans configuration, les emails sont simplement journalisés)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
