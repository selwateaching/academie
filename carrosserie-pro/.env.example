# Clé secrète Flask (session, CSRF) — générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-moi-en-production

# Base de données (SQLite par défaut, compatible PostgreSQL en production)
DATABASE_URL=sqlite:///carrosserie.db

# Compte administrateur créé automatiquement au premier lancement
ADMIN_EMAIL=admin@macarrosserie.fr
ADMIN_PASSWORD=change-moi-1234
ADMIN_NAME=Administrateur

FLASK_ENV=development
