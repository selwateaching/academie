# --- Application ---
SECRET_KEY=change-me-long-random-string
DATABASE_URL=sqlite:///./garage.db
# Premier administrateur créé au démarrage si aucun utilisateur n'existe
ADMIN_EMAIL=admin@garage.local
ADMIN_PASSWORD=change-me-now

# --- Identité du garage (utilisée dans les emails) ---
GARAGE_NAME=Garage & Carrosserie Exemple
GARAGE_CITY=Toulouse
GARAGE_PHONE=05 00 00 00 00
GARAGE_SERVICES=carrosserie, peinture, mécanique, entretien de flottes, véhicules de courtoisie

# --- IA (facultatif : sans clé, scoring et emails utilisent des règles/modèles simples) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Recherche de prospects (Google Places API, facultatif : sinon import CSV) ---
GOOGLE_PLACES_API_KEY=

# --- Envoi d'emails (facultatif : sinon les messages validés sont à envoyer à la main) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
