# --- Application ---
# En ligne (production) : APP_ENV=production refuse de démarrer avec les mots de passe/clés par défaut
# APP_ENV=production
SECRET_KEY=change-me-long-random-string
DATABASE_URL=sqlite:///./garage.db
# Premier administrateur créé au démarrage si aucun utilisateur n'existe
ADMIN_EMAIL=admin@garage.local
ADMIN_PASSWORD=change-me-now

# --- Identité du garage (utilisée dans les emails) ---
GARAGE_NAME=Garage & Carrosserie Exemple
GARAGE_CITY=Toulouse
GARAGE_PHONE=05 00 00 00 00
GARAGE_SERVICES=carrosserie, peinture, mécanique, entretien de flottes, véhicules de courtoisie

# --- IA (facultatif : sans clé, scoring et emails utilisent des règles/modèles simples) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Recherche de prospects (Google Places API, facultatif : sinon import CSV) ---
GOOGLE_PLACES_API_KEY=

# --- Envoi d'emails (facultatif : sinon les messages validés sont à envoyer à la main) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RELANCE_DAYS=5
# IMAP_HOST=imap.gmail.com   # lecture des réponses (déduit de SMTP_HOST si absent)
# REPORT_EMAIL=responsable@garage.fr   # reçoit chaque lundi le rapport et les recommandations de l'agent 5
# MAX_NO_ANSWER=3     # appels sans réponse avant « Sans suite »
# SANS_SUITE_DAYS=7   # jours après la 2e relance sans réponse avant « Sans suite »

# --- Note Google du garage de mécanique (facultatif : la phrase n'apparaît que si ces 3 valeurs sont renseignées) ---
# Chiffres RÉELS uniquement. La phrase précise que la note est celle du garage de mécanique.
# GARAGE_REVIEW_NOTE=4,9
# GARAGE_REVIEW_COUNT=120
# GARAGE_REVIEW_URL=https://maps.app.goo.gl/rU7Uzm5vS9Rv1goH8?g_st=ic
