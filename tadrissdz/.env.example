# Copiez ce fichier en ".env" et remplissez vos vraies valeurs.
# Ne mettez jamais le fichier ".env" dans Git (il est déjà ignoré).

# Clé API Anthropic (Claude), pour la génération IA (progressions, quiz, cours, corrections).
# À créer sur https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modèle IA utilisé (par défaut : claude-sonnet-5, identique à l'application actuelle)
TADRISSDZ_AI_MODEL=claude-sonnet-5

# Port d'écoute (fourni automatiquement par la plupart des hébergeurs)
PORT=8000

# --- Espace élève : code + mot de passe -------------------------------------------------
# 1 = plus aucun accès à l'espace élève sans mot de passe. À n'activer qu'une fois la liste
# des mots de passe distribuée à tous les élèves (sinon ils ne peuvent plus se connecter).
# Vide = période de transition : un élève sans mot de passe entre encore avec son code seul.
ELEVE_PASSWORD_REQUIRED=
