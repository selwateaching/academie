# ============================================================
# Académie IA – Variables d'environnement
# Copiez ce fichier en .env et renseignez vos valeurs
# ============================================================

# ── Django ───────────────────────────────────────────────────
# Générez une clé forte : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_moi_avec_une_cle_aleatoire_longue
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=

# ── Base de données ─────────────────────────────────────────
# SQLite par défaut (aucune configuration nécessaire)
DATABASE_URL=sqlite:///db.sqlite3

# ── Agent IA (Anthropic Claude) ─────────────────────────────
# Obtenez votre clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=votre_cle_api_anthropic
CLAUDE_MODEL=claude-sonnet-4-5

# ── Email (contact administration du lycée) ──────────────────
# Par défaut, les emails s'affichent dans les logs du serveur (aucune
# configuration requise). Pour un envoi réel, décommentez et complétez :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=votre_compte@gmail.com
# EMAIL_HOST_PASSWORD=mot_de_passe_application
# DEFAULT_FROM_EMAIL=academie-ia@votre-domaine.dz
EMAIL_LYCEE=administration@lycee.dz
