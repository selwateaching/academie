# ============================================================
# Académie IA – Variables d'environnement
# Copiez ce fichier en .env et renseignez vos valeurs
# ============================================================

# ── Django ───────────────────────────────────────────────────
# Générez une clé forte : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_moi_avec_une_cle_aleatoire_longue
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=

# ── Base de données ─────────────────────────────────────────
# SQLite par défaut (aucune configuration nécessaire)
DATABASE_URL=sqlite:///db.sqlite3

# ── Agent IA (Anthropic Claude) ─────────────────────────────
# Obtenez votre clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=votre_cle_api_anthropic
CLAUDE_MODEL=claude-sonnet-4-5
