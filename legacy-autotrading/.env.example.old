# ============================================================
# AutoTrading Pro – Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Anthropic API ──────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google OAuth (get from Google Cloud Console) ───────────
# Create OAuth 2.0 credentials at https://console.cloud.google.com
# Authorized redirect URI: http://localhost:5000/auth/gmail/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Flask ──────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_key_here
FLASK_ENV=development

# ── Database ───────────────────────────────────────────────
# SQLite (default, no setup required)
DATABASE_URL=sqlite:///auto_trading.db

# ── App Configuration ──────────────────────────────────────
# Maximum number of emails to fetch per sync
MAX_EMAILS_PER_SYNC=50
# Minimum score (0-100) to trigger a desktop notification
MIN_SCORE_NOTIFICATION=80
