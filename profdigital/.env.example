# Copiez ce fichier en ".env" et remplissez vos vraies valeurs.
# Ne mettez jamais le fichier ".env" dans Git (il est déjà ignoré).

# Clé secrète Flask (générez-en une avec :
# python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_moi

# Clé API Anthropic (Claude), pour l'IA réelle. À créer sur https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modèle IA utilisé pour générer les documents (par défaut : claude-opus-5)
PROFDIGITAL_AI_MODEL=claude-opus-5

# Email qui devient automatiquement administrateur (accès à /admin)
ADMIN_EMAIL=selwateaching@gmail.com

# Base de données (par défaut : fichier SQLite local profdigital.db)
# En production, préférez une vraie base persistante, ex. Postgres fourni par l'hébergeur :
# DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=

# Coordonnées bancaires affichées aux abonnés en fin d'essai gratuit
BANK_HOLDER=
BANK_NAME=
BANK_RIB=

# Port d'écoute (fourni automatiquement par la plupart des hébergeurs)
PORT=8000
